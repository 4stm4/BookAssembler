# Settings for `docker compose up` (and `npm run dev`): copy to .env and set
# what you need. Only the password is required, by docker compose; the rest
# are optional - unset, the default after "default:" is used. Agents (Ollama
# hosts, GPU runners) are also set up in the UI, in the agent manager; what
# is set there is kept in agents.json in the data directory.

# --- Access -------------------------------------------------------------------
# The login the browser asks for on :3000, for the UI and the API. Port 8000,
# the API without it, is published for this machine only (127.0.0.1).
# `npm run dev` without a password runs open. default user: admin
KAE_AUTH_PASSWORD=
#KAE_AUTH_USER=admin

# --- Text LLM -----------------------------------------------------------------
# The edge cluster's Ollama: block refinement, and translation when no GPU
# agent takes it. default: http://192.168.88.199:11434, qwen2.5:7b
#LLM_AGENT_URL=http://192.168.88.199:11434
#LLM_AGENT_MODEL=qwen2.5:7b
# The second host of the default agent list. default: http://192.168.88.71:11434
#LLM_AGENT_URL_2=http://192.168.88.71:11434

# Ollama host searched for a vision model, and one more tried first.
# default: http://localhost:11434, none
#KAE_OLLAMA_HOST=http://localhost:11434
#KAE_OLLAMA_VISION_HOST=

# --- Diagrams to TikZ (assembly) ---------------------------------------------
# The first one set is used: an OpenAI key, a local vision model, a local
# text model. With none, the diagrams are traced by OpenCV.
#OPENAI_API_KEY=
#VISION_MODEL=gpt-4o
#VISION_OLLAMA_MODEL=llava:13b
#VISION_OLLAMA_URL=http://192.168.88.71:11434
#LLM_TIKZ_MODEL=qwen2.5-coder:3b
#LLM_TIKZ_URL=http://192.168.88.71:11434

# --- Limits -------------------------------------------------------------------
# Pages read from a PDF at most. default: no limit.
#KAE_MAX_PAGES=
