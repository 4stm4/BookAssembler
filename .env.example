# Translation mode: "agent" (default, generates agent tasks) or "api" (direct API calls)
TRANSLATE_MODE=agent

# Compile mode: "docker" (default, local) or "ssh" (remote host)
COMPILE_MODE=docker

# SSH mode settings (only needed when COMPILE_MODE=ssh)
COMPILE_HOST=alex@192.168.88.71
COMPILE_DIR=~/micro8086_translate/latex_output
